{
  // Cloudflare Pages project: static site + one Pages Function that forwards
  // /api/room/:code WebSockets to the Rust Durable Object in playcubes-rooms.
  "name": "playcubes",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room", "script_name": "playcubes-rooms" }]
  }
}
